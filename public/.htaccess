# Конфигурация статического сайта по [contracts/routes.md].
#
# Прежнее правило подстановки главной страницы снято: оно отдавало её кодом 200 на любой
# несуществующий адрес — механика одностраничного приложения, превращавшая каждую опечатку
# в странице-дубль, отвечающую успехом. Отсюда же требование SC-008.

# Страница ошибки корня и украинского раздела. Разделы /ru/ и /en/ перекрывают это объявление
# собственными файлами: ограничить директиву каталогом внутри .htaccess нечем, а <Directory>
# в нём запрещён.
ErrorDocument 404 /404.html

<IfModule mod_dir.c>
  # Сборка выдаёт <путь>/index.html, и адрес без завершающего слеша приходит на форму со слешем
  # именно этим перенаправлением. На нём стоят действующие внешние ссылки /ru и /en — терять их
  # нельзя, поэтому поведение объявлено явно, а не оставлено на умолчание сервера.
  DirectorySlash On
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  # Карты сайта: Apache по умолчанию отдаёт text/xml, а preview и проверка из runbook —
  # application/xml. Тип объявлен здесь, чтобы прод совпадал с тем, что проверяется локально.
  AddType application/xml .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Имя файла сборки содержит хэш содержимого, поэтому обновление приходит новым именем,
  # а старое кэшируется бессрочно. Расширение здесь и есть признак принадлежности к сборке:
  # css, js, woff2, avif, webp и jpg рождаются только в _astro/. Единственный файл с постоянным
  # именем — изображение предпросмотра в public/, и оно единственное имеет тип png.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"

  # Изображение предпросмотра: адрес постоянный и кэшируется соцсетями, срок умеренный.
  ExpiresByType image/png "access plus 1 day"

  # Правка текста обязана доходить до посетителя, поэтому HTML кэшируется минутами.
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|avif|webp|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Перепроверка обязательна: без неё вернувшийся посетитель получает страницу, ссылающуюся
  # на уже удалённые файлы предыдущей сборки.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
