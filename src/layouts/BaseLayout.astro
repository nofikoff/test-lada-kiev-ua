---
/**
 * Каркас всех страниц сайта.
 *
 * Импорт `../index.css` — единственное подключение Tailwind к сборке: интеграция
 * `@astrojs/tailwind` в проект не встала, а её вторая работа (подстановка базового стиля)
 * ничем другим не заменена. Без этой строки сборка проходит зелёной и отдаёт страницы,
 * к которым не применена ни одна утилита — ADR-010.
 */
import '../index.css';
// Слой движения отдельным файлом: единственная часть работы, которую при откате снимают
// целиком, не задев палитру, шкалу и ритм (src/styles/ambience.css).
import '../styles/ambience.css';
import { Font } from 'astro:assets';
import Ambience from '../components/Ambience.astro';
import ErrorHead from '../components/ErrorHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import { type Locale } from '../i18n/ui';
import { type ServiceCategory } from '../i18n/paths';

interface Props {
  locale: Locale;
  category?: ServiceCategory;
  /** Страница ошибки: у неё другой состав заголовочной части, а не урезанный тот же. */
  error?: boolean;
}

const { locale, category, error = false } = Astro.props;

/**
 * Предзагружается подмножество языка страницы: английская версия не тянет кириллицу, и наоборот.
 * Предзагрузка обоих подмножеств обеих гарнитур соревновалась бы за канал с изображением
 * первого экрана, которое и есть самый крупный элемент отрисовки.
 *
 * Отбор идёт только по подмножеству, и начертание в нём не участвует намеренно: Google отдаёт
 * одну переменную гарнитуру на подмножество, объявляя её несколькими правилами @font-face
 * с разным `font-weight` и одним и тем же файлом. Astro складывает в список предзагрузки один
 * элемент на файл и запоминает у него начертание первого попавшегося правила — для Inter это
 * 300, для Cormorant тоже 300. Отбор `{ weight: 700 }` поэтому не находит ничего и молча
 * оставляет страницу вообще без предзагрузки.
 *
 * У Cormorant к подмножеству добавлено прямое начертание: курсив — отдельный файл на каждое
 * подмножество, он нужен в двух местах страницы и на критическом пути ему делать нечего.
 * Это отбор по начертанию (`style`), а не по толщине (`weight`), поэтому оговорка выше цела.
 */
const subset = locale === 'en' ? 'latin' : 'cyrillic';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    {/*
      Монограмма студии во встроенном адресе: сетевого запроса не появляется, как и
      у прежнего эмодзи. Латунью набраны обе буквы, а не одна, как в `Monogram.astro`: шёлк
      на светлой полосе вкладок исчезает. Решётка цвета записана как `%23` — незакодированная
      обрывает адрес на фрагменте, и вкладка остаётся пустой при исправной на вид разметке.
    */}
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><text x='32' y='45' text-anchor='middle' font-family='Georgia, serif' font-size='38' fill='%23C9A961'>LN</text></svg>"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {error ? <ErrorHead locale={locale} /> : <SeoHead locale={locale} category={category} />}

    {/* Шрифты отдаются с собственного домена: файлы скачаны на сборке, объявления @font-face
         и метрики запасного шрифта Astro выводит сюда сам. Сторонних доменов в загрузке нет. */}
    <Font cssVariable="--font-inter" preload={[{ subset }]} />
    <Font cssVariable="--font-cormorant" preload={[{ subset, style: 'normal' }]} />

    {/* Google Analytics. Переносится без изменений: отложенная загрузка потеряла бы визиты
         и сделала статистику до и после миграции несопоставимой (ADR-011). */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WZT8TJLSDP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-WZT8TJLSDP');
    </script>
  </head>
  <body>
    <Ambience />
    {/* Содержимое поднято над фоновым слоем собственным контекстом наложения. Заливки
         на обёртке нет намеренно: непрозрачный фон здесь погасил бы весь слой света, ради
         которого он и заведён. Цвет страницы задаёт `body` в src/index.css. */}
    <div class="relative z-10 min-h-screen">
      <Header locale={locale} />
      <main>
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>
