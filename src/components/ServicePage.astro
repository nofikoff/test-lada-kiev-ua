---
/**
 * Состав страницы услуги — категории или подстраницы — в одном месте на все языковые версии,
 * как и у главной: копия для подстраницы разошлась бы с ним на первой правке. Страницы
 * `src/pages/**` остаются объявлением локали и ничем больше.
 *
 * Текст берётся из коллекции, цены — из тех же данных, что и прайс главной, по группам
 * категории или реестра подстраницы (docs/specs/content-model.md §Инварианты). Второй записи цен
 * на сайте нет, поэтому страница услуги и главная разойтись не могут.
 */
import { render } from 'astro:content';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import MapLinks from './MapLinks.astro';
import Monogram from './Monogram.astro';
import PriceGroup from './PriceGroup.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import type { MapPageKind } from '../data/seo-map';
import { servicePageOf } from '../data/subpages';
import { pagePath, type ServicePageRef } from '../i18n/paths';
import { ui, type Locale } from '../i18n/ui';

/** Виды страниц базы знаний в карте: со страницы услуги ведут только рёбра к ним. */
const GUIDE_KINDS: readonly MapPageKind[] = ['hub', 'entity', 'question'];

interface Props {
  locale: Locale;
  page: ServicePageRef;
}

const { locale, page } = Astro.props;
const t = ui[locale];

const { copy, groups, method, parentHeading } = await servicePageOf(locale, page);
const { Content } = await render(copy);

/**
 * Сноска об обновлении относится к перманентному макияжу — ровно как на вкладке главной; страница
 * бровей — его часть, поэтому сноска стоит и на ней.
 */
const withNote = page.category === 'permanent';
---

<Section rhythm="air">
  <Fragment slot="backdrop">
    <Monogram mode="watermark" side="right" />
  </Fragment>

  <div class="mx-auto w-full max-w-4xl px-4">
    <Breadcrumbs
      locale={locale}
      parents={
        parentHeading ? [{ name: parentHeading, href: pagePath(locale, { category: page.category }) }] : []
      }
      current={copy.data.heading}
    />

    <h1 class="section-title copy__title">{copy.data.heading}</h1>

    <div class="service-copy">
      {/*
        Атрибут — договорённость со сквозной проверкой: объём и уникальность текста считаются
        по этому контейнеру (tests/support/site.ts), поэтому внутри него лежит ТОЛЬКО текст
        страницы. Врезка повторяется на всех страницах услуг слово в слово, и попади она
        внутрь — сверка уникальности абзацев справедливо покраснела бы.

        Обёртка объявлена `display: contents`: сама она в раскладке не участвует, а абзацы
        текста становятся элементами той же сетки, что и врезка, — иначе `order` ниже не
        смог бы их чередовать. Типографику текста даёт общий класс `.copy` (src/index.css).
      */}
      <div class="copy copy__flow" data-service-copy>
        <Content />
      </div>

      {/*
        Врезка стоит в разметке последней, а показывается сразу за вступлением: порядок задаёт
        `order` на сетке контейнера. Вставить её внутрь текста нельзя — он приходит из markdown
        одним куском, — а из двух зол это меньшее: дополняющий блок с фактами, которые целиком
        повторены в подвале, экранный диктор прочтёт последним, и потерять на этом нечего.
      */}
      <aside class="insert">
        <span class="eyebrow">{t.nav.contacts}</span>
        <p class="insert__line">{t.footer.schedule}</p>
        <p class="insert__note">{t.footer.appointment}</p>
        <p class="insert__line">{t.footer.address}</p>
        <a href="tel:+380995570045" class="insert__tel">(099) 557-00-45</a>
      </aside>
    </div>

    {/*
      Вход в базу знаний — рёбра карты к её страницам, вне `[data-service-copy]`: объём и
      уникальность текста считаются без них, а тексты категорий для этого не правятся. Собранной
      страницы на конце ребра нет — блока нет (FR-010).
    */}
    <MapLinks locale={locale} page={page} toKinds={GUIDE_KINDS} />

    <p class="copy__cta">
      <a href="tel:+380995570045" class="btn-primary">
        <Icon name="phone" size={20} />
        <span>{t.hero.cta}</span>
      </a>
    </p>
  </div>
</Section>

<Section rhythm="work" id="services">
  <div class="mx-auto w-full max-w-6xl px-4">
    <div class="price__top">
      <SectionHeading eyebrow={t.priceList.eyebrow} title={t.priceList.title} />
      <p class="price__discount">{t.priceList.discount}</p>
    </div>

    <div class="price__groups">
      {
        groups.map((group, index) => (
          <PriceGroup locale={locale} group={group} method={method} phase={index} />
        ))
      }

      {withNote && <p class="price__note">{t.priceList.permanentNote}</p>}
    </div>
  </div>
</Section>

<style>
  .price__top {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .price__discount {
    @apply text-brass;
    font-size: 0.875rem;
  }

  .price__groups {
    display: grid;
    gap: var(--rhythm-tight);
  }

  .price__note {
    @apply text-muted;
    font-size: var(--step-caption);
  }

  .copy__title {
    margin-bottom: var(--rhythm-tight);
  }

  .copy__cta {
    margin-top: var(--rhythm-tight);
  }

  /**
   * Контейнер — сетка ради одного: `order` ставит врезку сразу за вступлением, хотя
   * в разметке она стоит последней (причина — в комментарии у самой врезки).
   *
   * Счётчик разделов сбрасывается здесь, а не только в `.copy`: на элементе с `display: contents`
   * сброс счётчика Chromium и WebKit не применяют (замер 2026-10-18).
   */
  .service-copy {
    display: grid;
    align-content: start;
    max-width: var(--measure);
    counter-reset: copy-section;
  }

  .copy__flow {
    display: contents;
  }

  .copy__flow > :global(*) {
    order: 3;
  }

  .copy__flow > :global(p:first-of-type) {
    order: 1;
  }

  .service-copy > .insert {
    order: 2;
  }

  /**
   * Акцентная врезка после вступления: расписание, запись, адрес и телефон —
   * то, ради чего страницу категории открывают из поиска. Служебный уровень текста здесь
   * не `--muted`: подложка врезки светлее страницы, и на ней он даёт 4.4:1
   * (правило 4 docs/specs/design-tokens.md).
   */
  .insert {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    margin-bottom: var(--rhythm-tight);
    padding: 1.5rem 1.75rem;
    border-left: 1px solid rgb(var(--brass));
    background: rgb(var(--raised) / 0.5);
  }

  .insert .eyebrow {
    margin-bottom: 0.5rem;
  }

  .insert__line {
    @apply text-silk;
    font-size: var(--step-body);
  }

  .insert__note {
    @apply text-silk-dim;
    font-size: var(--step-caption);
  }

  .insert__tel {
    @apply text-brass;
    margin-top: 0.5rem;
    font-size: var(--step-body);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    border-bottom: 1px solid var(--hair);
    transition: color 0.3s;
  }

  .insert__tel:hover {
    @apply text-brass-lt;
  }
</style>
