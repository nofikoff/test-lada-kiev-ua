---
/**
 * Страница эксперта: портрет, текст в третьем лице и все статьи базы знаний своего языка
 * (specs/007-knowledge-base-pilot/contracts/links.md §Placement). Крошек нет: страница не стоит
 * под разделом. Список собирается из коллекции, поэтому новая статья появляется здесь без правки.
 */
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Monogram from './Monogram.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { expertCopy } from '../data/expert';
import { portrait } from '../data/gallery';
import { guideIndex } from '../data/guide';
import { displayDate, guide, isoDay, type GuideLocale } from '../i18n/guide';
import { pagePath } from '../i18n/paths';

interface Props {
  locale: GuideLocale;
}

const { locale } = Astro.props;
const t = guide[locale];

const entry = await expertCopy(locale);
const { Content } = await render(entry);
const photo = (await portrait()).data;

const index = await guideIndex();
const articles = index.articles(locale).map((article) => ({
  href: pagePath(locale, index.refOf(article)),
  heading: article.data.heading,
  published: article.data.published,
}));
---

<Section rhythm="air">
  <Fragment slot="backdrop">
    <Monogram mode="watermark" side="right" />
  </Fragment>

  <div class="mx-auto w-full max-w-6xl px-4">
    <div class="expert">
      <div class="expert__portrait">
        <Picture
          src={photo.photo}
          alt={photo.alt[locale]}
          formats={['avif', 'webp']}
          widths={[360, 720, 1080].filter((width) => width <= photo.photo.width)}
          sizes="(min-width: 58rem) 22rem, min(22rem, 100vw)"
          loading="eager"
          decoding="async"
          pictureAttributes={{ class: 'contents' }}
          class="expert__image"
          style={{ objectPosition: photo.focus }}
        />
      </div>

      <div class="expert__body">
        <h1 class="section-title">{entry.data.heading}</h1>

        {/* Атрибут — договорённость с проверками: абзацы сверяются с «Про нас» по нему (tests/support/site.ts). */}
        <div class="copy expert__copy" data-expert-copy>
          <Content />
        </div>

        <div class="expert__articles">
          <SectionHeading eyebrow={t.expertArticles.eyebrow} title={t.expertArticles.title} />
          <ul class="expert__list">
            {
              articles.map((article) => (
                <li class="expert__item">
                  <a href={article.href} class="expert__link">
                    {article.heading}
                  </a>
                  <time datetime={isoDay(article.published)} class="expert__date">
                    {displayDate(locale, article.published)}
                  </time>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .expert {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  @media (min-width: 58rem) {
    .expert {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: start;
    }
  }

  .expert__portrait {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--hair-soft);
  }

  .expert__portrait :global(.expert__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .expert__body {
    display: grid;
    gap: var(--rhythm-tight);
  }

  .expert__copy {
    max-width: var(--measure);
  }

  .expert__list {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .expert__item {
    display: grid;
    gap: 0.25rem;
  }

  .expert__link {
    @apply font-serif text-brass underline underline-offset-4;
    font-size: var(--step-subtitle);
    font-weight: 400;
    line-height: 1.2;
    transition: color 0.3s;
  }

  .expert__link:hover {
    @apply text-brass-lt;
  }

  .expert__date {
    @apply text-silk-dim;
    font-size: var(--step-caption);
  }
</style>
