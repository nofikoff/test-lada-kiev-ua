---
/**
 * Состав главной страницы и его порядок — в одном месте на три языковые версии.
 * Страницы `src/pages/**` остаются тем, чем должны быть: объявлением локали и ничем больше.
 */
import About from './About.astro';
import Certificates from './Certificates.astro';
import Gallery from './Gallery.astro';
import Hero from './Hero.astro';
import PriceTabs from './PriceTabs.astro';
import ServicesOverview from './ServicesOverview.astro';
import { type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Hero locale={locale} />
<About locale={locale} />
<Gallery locale={locale} />
<ServicesOverview locale={locale} />
<PriceTabs locale={locale} />
<Certificates locale={locale} />
