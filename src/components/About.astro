---
/** Перенос `About.tsx` один в один. */
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<section id="about" class="py-20 md:py-32 bg-lada-darker">
  <div class="max-w-5xl mx-auto px-4 text-center">
    <h2 class="section-title">{t.about.title}</h2>

    <h3 class="text-2xl md:text-3xl font-serif text-white mb-8 [text-wrap:balance]">
      {t.about.heading}
    </h3>

    <div class="space-y-6 text-lg text-white/70 leading-relaxed max-w-3xl mx-auto">
      <p class="[text-wrap:balance]">{t.about.text1}</p>
      <p class="[text-wrap:balance]">{t.about.text2}</p>
      <p class="[text-wrap:balance]">{t.about.text3}</p>
      <p class="text-lada-gold font-medium text-xl [text-wrap:balance]">{t.about.text4}</p>
    </div>

    <div class="mt-12 flex justify-center">
      <div class="w-24 h-0.5 bg-gradient-to-r from-transparent via-lada-gold to-transparent"></div>
    </div>
  </div>
</section>
