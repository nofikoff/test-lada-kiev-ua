---
/**
 * Повествовательная секция: единственная на главной, где текст читают подряд, — отсюда
 * и ступень ритма `air`, и мера строки.
 *
 * Пара «надзаголовок + заголовок» собрана из уже существующих строк: надзаголовком стоит
 * название секции (`about.title`), заголовком — её первая строка (`about.heading`). Своего
 * ключа надзаголовок не заводит, в отличие от остальных секций: на uk и ru он дословно
 * повторил бы `about.title`, а на en («About» против «About Us») вытеснил бы строку, которую
 * ищет в английской разметке сверка полноты контента.
 *
 * Уровень заголовка — h2, умолчание примитива. До пересборки секция несла два заголовка, и
 * `h3` был вторым, под `h2`; надзаголовок вторым заголовком не является, поэтому оставшийся
 * `h3` шёл сразу за `h1` страницы и ронял доступность до 98 (`heading-order`).
 */
import Monogram from './Monogram.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<Section rhythm="air" id="about">
  <Fragment slot="backdrop">
    <Monogram mode="watermark" side="right" />
  </Fragment>

  <div class="mx-auto w-full max-w-6xl px-4">
    <div class="about">
      <div>
        <SectionHeading eyebrow={t.about.title} title={t.about.heading} />
      </div>

      <div class="about__body">
        <p class="lede">{t.about.text1}</p>
        <p>{t.about.text2}</p>
        <p>{t.about.text3}</p>

        {/* Разделитель прежней версии: короткая полоса с растворяющимися краями. Теперь
             волосок, который прочерчивается при въезде в кадр, а в браузере без таймлайна
             стоит на месте — то есть остаётся ровно тем, чем был. */}
        <div class="rule rule--draw about__rule"></div>

        <p class="about__close">{t.about.text4}</p>
      </div>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  @media (min-width: 58rem) {
    .about {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: start;
    }
  }

  .about__body {
    display: grid;
    gap: 1.4rem;
    max-width: var(--measure);
  }

  .about__rule {
    margin-block: 0.6rem;
  }

  /* Закрывающая строка — курсивом антиквы: одно из двух мест, ради которых курсив
     вообще загружается (ADR-014). */
  .about__close {
    @apply font-serif text-brass;
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.4;
  }
</style>
