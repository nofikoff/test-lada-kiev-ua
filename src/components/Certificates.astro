---
/**
 * Подарочные сертификаты: единственная карточка сайта на приподнятой поверхности (`--raised`),
 * с бликом по верхней кромке рамки — тем же мерцанием, что проходит по волоскам (FR-012).
 *
 * Круглая подложка под иконкой ушла вслед за карточками услуг; сама иконка осталась.
 */
import Icon from './Icon.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<Section rhythm="work" id="certificates">
  <div class="mx-auto w-full max-w-4xl px-4">
    <div class="gift">
      <Icon name="gift" size={38} class="text-brass" />

      <SectionHeading eyebrow={t.certificates.eyebrow} title={t.certificates.title} align="center" />

      <p class="gift__text">{t.certificates.text}</p>

      <a href="tel:+380995570045" class="btn-primary">
        <Icon name="phone" size={20} />
        <span>{t.certificates.cta}</span>
      </a>
    </div>
  </div>
</Section>

<style>
  .gift {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    overflow: hidden;
    border: 1px solid var(--hair);
    background: rgb(var(--raised) / 0.85);
    text-align: center;
  }

  /* Блик по кромке: та же `sweep`, что и на волосках, только с длинным периодом —
     рамка карточки крупнее волоска, и частый блик читался бы как мигание. */
  .gift::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgb(var(--brass-lt)), transparent);
    animation: sweep 11s cubic-bezier(0.45, 0, 0.55, 1) 1.5s infinite;
  }

  .gift__text {
    max-width: var(--measure);
  }
</style>
