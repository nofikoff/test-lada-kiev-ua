---
/**
 * Статья базы знаний: крошки «главная → хаб → статья», заголовок, подпись с датами публикации и
 * правки, текст и ссылки карты после него
 * (docs/specs/routes.md §Links from the map).
 * Скрипта нет: всё собирается на сборке.
 */
import { render } from 'astro:content';
import Breadcrumbs from './Breadcrumbs.astro';
import GuideByline from './GuideByline.astro';
import MapLinks from './MapLinks.astro';
import Monogram from './Monogram.astro';
import Section from './Section.astro';
import { guideIndex } from '../data/guide';
import { type GuideLocale } from '../i18n/guide';
import { pagePath, type GuidePageRef } from '../i18n/paths';

interface Props {
  locale: GuideLocale;
  page: GuidePageRef;
}

const { locale, page } = Astro.props;

const index = await guideIndex();
const entry = index.entryOf(locale, page);
// Хаб языка у статьи есть всегда: без него сборка остановлена (остановка № 8, src/data/guide.ts).
const hub = index.hubOf(locale, page.category)!;
const { Content } = await render(entry);
---

<Section rhythm="air">
  <Fragment slot="backdrop">
    <Monogram mode="watermark" side="right" />
  </Fragment>

  <div class="mx-auto w-full max-w-4xl px-4">
    <Breadcrumbs
      locale={locale}
      parents={[{ name: index.entryOf(locale, hub.ref).data.heading, href: pagePath(locale, hub.ref) }]}
      current={entry.data.heading}
    />

    <h1 class="section-title article__title">{entry.data.heading}</h1>

    <GuideByline locale={locale} dates={{ published: entry.data.published, modified: entry.data.modified }} />

    {/* Атрибут — договорённость с проверками: объём и уникальность текста считаются по нему (tests/support/site.ts). */}
    <div class="copy article__copy" data-guide-copy>
      <Content />
    </div>

    <MapLinks locale={locale} page={page} />
  </div>
</Section>

<style>
  .article__title {
    margin-bottom: 1.25rem;
  }

  /* Мера колонки — та же, что у текста страницы услуги: у `.copy` своей меры нет (src/index.css). */
  .article__copy {
    max-width: var(--measure);
  }
</style>
