---
/**
 * Первый экран: текст и портрет Лады (FR-017 из 002; FR-001…FR-008 из 003, contracts/hero.md).
 *
 * Портрет стоит колонкой рядом с текстом, а не фоном под ним — почему, см. ADR-002. Отсюда два
 * следствия раскладки. Текст лежит на угле самой секции, и его контраст не зависит от кадра
 * (FR-017 держится без отдельной подложки). Монограммы здесь больше нет: разреженный край,
 * который она заполняла, занял портрет (FR-008 заменяет FR-018 из 002).
 *
 * В разметке текст идёт раньше портрета — `h1` первым читает и диктор, и поисковик; наверх на
 * узком экране портрет поднимает `order`.
 */
import { Picture } from 'astro:assets';
import Glow from './Glow.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { portrait } from '../data/gallery';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const photo = (await portrait()).data;

/**
 * Восемь порошинок первого экрана; остальные двенадцать живут в сквозном фоне, который
 * секция первого экрана закрывает своей заливкой (contracts/motion.md из 002: `mote × 20`).
 */
const motes = [
  { left: '12%', duration: '22s', delay: '-1s', sway: '3vw', size: '3px' },
  { left: '22%', duration: '30s', delay: '-8s', sway: '-2vw', size: '2px' },
  { left: '34%', duration: '26s', delay: '-15s', sway: '4vw', size: '4px' },
  { left: '46%', duration: '34s', delay: '-4s', sway: '-3vw', size: '3px' },
  { left: '58%', duration: '24s', delay: '-19s', sway: '2vw', size: '2px' },
  { left: '69%', duration: '32s', delay: '-11s', sway: '-4vw', size: '4px' },
  { left: '81%', duration: '28s', delay: '-6s', sway: '3vw', size: '3px' },
  { left: '91%', duration: '36s', delay: '-22s', sway: '-2vw', size: '2px' },
];
---

<Section rhythm="hero" reveal={false}>
  <Fragment slot="backdrop">
    <Glow size="32rem" right="-8rem" top="-10rem" tone="warm" period="19s" beat="a" />
    <Glow size="24rem" left="6%" bottom="-8rem" tone="lit" period="27s" phase="-4s" beat="b" />

    <div class="hero__dust" aria-hidden="true">
      {
        motes.map((mote) => (
          <span
            class="mote"
            style={{
              left: mote.left,
              '--mote-size': mote.size,
              '--mote-dur': mote.duration,
              '--mote-delay': mote.delay,
              '--sway': mote.sway,
            }}
          />
        ))
      }
    </div>

    {/* Подсказка прокрутки: волосок с каплей света вместо подпрыгивающей «мышки» (T024 из 002). */}
    <div class="scroll-hint" aria-hidden="true"></div>
  </Fragment>

  <div class="hero__grid mx-auto w-full max-w-6xl px-4">
    <div class="hero__in">
      <span class="eyebrow">{t.footer.landmark} · {t.nav.hours}</span>

      <h1 class="display">{t.hero.title}</h1>

      <p class="hero__sub">{t.hero.subtitle}</p>

      <p class="lede hero__lede">{t.hero.description}</p>

      <div class="hero__cta">
        <a href="tel:+380995570045" class="btn-primary">
          <Icon name="phone" size={20} />
          <span>{t.hero.cta}</span>
        </a>
      </div>

      <p class="hero__note">{t.footer.address} {t.footer.landmark}</p>
    </div>

    <div class="hero__portrait">
      {/* Наезд живёт на обёртке, а не на изображении: прозрачность и трансформация самого
           `<img>` не анимируются, иначе отрисовка портрета ждала бы движения (research.md §R4). */}
      <div class="hero__zoom">
        <Picture
          src={photo.photo}
          alt={photo.alt[locale]}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1440]}
          sizes="(min-width: 62rem) 40vw, 100vw"
          priority
          pictureAttributes={{ class: 'contents' }}
          class="h-full w-full object-cover"
          style={{ objectPosition: photo.focus }}
        />
      </div>
      <div class="hero__veil" aria-hidden="true"></div>
    </div>
  </div>
</Section>

<style>
  /**
   * `--head` — высота шапки (`h-16` и `md:h-20` в `Header.astro`). Шапка фиксирована и лежит
   * поверх секции; верхний отступ секции (`--rhythm-work`) её не всегда перекрывает, и остаток
   * добирается здесь — иначе шапка режет лицо на портрете.
   */
  .hero__grid {
    --head: 4rem;
    display: grid;
    gap: 1.5rem;
    padding-top: max(0px, var(--head) + 0.75rem - var(--rhythm-work));
  }

  @media (min-width: 48rem) {
    .hero__grid {
      --head: 5rem;
    }
  }

  .hero__in {
    display: grid;
    gap: 1.15rem;
    max-width: 40rem;
  }

  /**
   * Узкий экран (FR-003, FR-004). Портрет стоит над текстом, и его высота — то, что остаётся от
   * экрана после основной части текста: надзаголовка, заголовка, подзаголовка и кнопки
   * (`--primary`). Кнопка поэтому идёт сразу за подзаголовком, а описание и адрес — после неё:
   * полная колонка на 360×740 выше остатка экрана, и кнопка ушла бы за край при любом портрете.
   */
  .hero__portrait {
    --primary: 20rem;
    position: relative;
    order: -1;
    overflow: hidden;
    margin-inline: -1rem;
    height: clamp(11rem, 100svh - var(--rhythm-work) - var(--rhythm-tight) - var(--primary), 62svh);
    /* Края уходят в уголь секции: у портрета нет рамки, он проступает из темноты. */
    mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 72%, transparent);
  }

  .hero__lede,
  .hero__note {
    order: 1;
  }

  .hero__zoom {
    position: absolute;
    inset: 0;
    animation: drift 32s ease-in-out infinite;
    will-change: transform;
  }

  /**
   * Раскрытие из затемнения (FR-007): слой угля над портретом гаснет за 1.8 с и дальше едва
   * дышит. В покое слой прозрачен — поэтому при уменьшенном движении, где анимации сняты
   * глобально, портрет виден сразу, а не остаётся под завесой.
   */
  .hero__veil {
    position: absolute;
    inset: 0;
    background: rgb(var(--ink));
    opacity: 0;
    animation:
      wake 1.8s cubic-bezier(0.2, 0.6, 0.2, 1) both,
      veil-breath 13s ease-in-out 1.8s infinite;
  }

  /**
   * Широкий экран, а также телефон, повёрнутый горизонтально: колонки. Высота портрета берётся
   * от экрана, ширина — от высоты через пропорцию 4:5, и обе ограничены исходником (FR-005).
   */
  @media (min-width: 62rem), (orientation: landscape) and (max-height: 32rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: clamp(1.5rem, 4vw, 4rem);
    }

    .hero__in {
      gap: 1.75rem;
    }

    .hero__lede,
    .hero__note {
      order: 0;
    }

    .hero__portrait {
      order: 0;
      margin-inline: 0;
      aspect-ratio: 4 / 5;
      height: min(86svh - var(--head) - var(--rhythm-tight), 900px);
      max-width: 720px;
      /* Со стороны текста и снизу край уходит глубже, сверху и справа — едва: кадр не вклеен. */
      mask-image:
        linear-gradient(to right, transparent, #000 18%, #000 94%, transparent),
        linear-gradient(to bottom, transparent, #000 6%, #000 84%, transparent);
      mask-composite: intersect;
    }
  }

  @media (orientation: landscape) and (max-height: 32rem) {
    .hero__in {
      gap: 0.75rem;
    }
  }

  .hero__dust {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* На узком экране надзаголовок переносится: без балансировки на второй строке остаётся
     хвост в одно значение — ровно тот случай, который спека 002 называет краевым. */
  .hero__in > .eyebrow {
    text-wrap: balance;
  }

  .hero__sub {
    @apply font-serif text-brass;
    font-size: clamp(1.25rem, 3.4vw, 1.75rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
  }

  /* Колонка описания уже общей меры: 46 знаков в строке (T022 из 002) — описание первого экрана
     читается с одного взгляда, а `--measure` задан для абзацев, которые читают подряд. */
  .hero__lede {
    max-width: 29rem;
  }

  .hero__note {
    @apply text-muted;
    font-size: var(--step-caption);
  }

  /* Волосок с каплей света: капля проходит сверху вниз и гаснет за краем. */
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 5.5rem;
    overflow: hidden;
    background: var(--hair-soft);
  }

  .scroll-hint::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 2.5rem;
    background: linear-gradient(to bottom, transparent, rgb(var(--brass)), transparent);
    animation: drip 3.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
