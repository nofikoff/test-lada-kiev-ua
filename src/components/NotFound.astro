---
/**
 * Тело страницы ошибки. Шапка и подвал остаются на месте: посетитель, попавший сюда с внешней
 * ссылки, должен иметь чем продолжить, а не одну надпись.
 *
 * Секция объявляет роль ритма, а высоту держит утилитой: `62svh` не даёт подвалу подняться
 * к середине экрана на странице, где содержимого немного.
 */
import Icon from './Icon.astro';
import Section from './Section.astro';
import { pagePath } from '../i18n/paths';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<Section rhythm="air" class="min-h-[62svh]">
  <div class="mx-auto max-w-2xl px-4 text-center">
    <p class="error__code">404</p>

    <h1 class="section-title error__heading">{t.error.heading}</h1>

    <p class="lede error__text">{t.error.text}</p>

    <div class="error__actions">
      <a href={pagePath(locale)} class="btn-quiet">{t.error.cta}</a>
      <a href="tel:+380995570045" class="btn-primary">
        <Icon name="phone" size={20} />
        <span>{t.hero.cta}</span>
      </a>
    </div>
  </div>
</Section>

<style>
  /* Крупное «404» над заголовком: цифра здесь — рисунок, а не текст, поэтому и набрана
     антиквой на приглушённой латуни. */
  .error__code {
    @apply font-serif text-brass;
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 300;
    line-height: 1;
    opacity: 0.45;
  }

  .error__heading {
    margin-top: 1.5rem;
  }

  .error__text {
    margin-top: 1.5rem;
    margin-inline: auto;
    max-width: var(--measure);
  }

  .error__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: var(--rhythm-tight);
  }
</style>
