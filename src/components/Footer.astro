---
/**
 * Перенос `Footer.tsx` один в один, включая встроенную карту.
 * Год в подписи вычисляется на сборке, а не в браузере: страница статическая.
 */
import Icon from './Icon.astro';
import logo from '../assets/logo.jpg';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
const map =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2540.5!2d30.5213!3d50.4501!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40d4ce50f8b6e3ed%3A0x5f1e4d5b5a5b5e5d!2z0YPQuy4g0JzQsNC70LDRjyDQltC40YLQvtC80LjRgNGB0LrQsNGPLCAxMCwg0JrQuNC10LI!5e0!3m2!1sru!2sua!4v1234567890';
---

<footer id="contacts" class="bg-lada-darker border-t border-lada-gray">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h3 class="text-2xl font-serif text-lada-gold mb-8">
          {t.nav.contacts}
        </h3>

        <div class="space-y-6">
          <div class="flex items-start space-x-4">
            <Icon name="map-pin" class="w-6 h-6 text-lada-gold flex-shrink-0 mt-1" />
            <div>
              <p class="text-white">{t.footer.address}</p>
              <p class="text-white/60">{t.footer.landmark}</p>
            </div>
          </div>

          <div class="flex items-center space-x-4">
            <Icon name="phone" class="w-6 h-6 text-lada-gold flex-shrink-0" />
            <a
              href="tel:+380995570045"
              class="text-white hover:text-lada-gold transition-colors text-lg"
            >
              (099) 557-00-45
            </a>
          </div>

          <div class="flex items-start space-x-4">
            <Icon name="clock" class="w-6 h-6 text-lada-gold flex-shrink-0 mt-1" />
            <div>
              <p class="text-white">{t.footer.schedule}</p>
              <p class="text-white/50 text-sm">{t.footer.appointment}</p>
            </div>
          </div>

          <div class="flex items-center space-x-4">
            <Icon name="instagram" class="w-6 h-6 text-lada-gold flex-shrink-0" />
            <a
              href="https://www.instagram.com/massage.ln.kyiv/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white hover:text-lada-gold transition-colors"
            >
              @massage.ln.kyiv
            </a>
          </div>
        </div>
      </div>

      <div class="h-64 md:h-auto rounded-xl overflow-hidden">
        <iframe
          src={map}
          width="100%"
          height="100%"
          style="border: 0; min-height: 250px"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lada N Location"></iframe>
      </div>
    </div>

    <div
      class="mt-12 pt-8 border-t border-lada-gray flex flex-col md:flex-row items-center justify-between gap-4"
    >
      <div class="flex items-center space-x-3">
        <img src={logo.src} alt="Lada N" class="h-8 w-auto brightness-75 contrast-125" />
        <span class="text-white/60">|</span>
        <span class="text-white/60">Lada N</span>
      </div>

      <p class="text-white/40 text-sm">
        &copy; {year} Lada N. {t.footer.rights}
      </p>
    </div>
  </div>
</footer>
