---
/**
 * Подвал: контакты подписями (FR-025) и карта под инверсией (FR-024).
 *
 * Подписи блоков — не украшение: сегодня блок опознаётся только по иконке, то есть не
 * опознаётся вовсе там, где иконку не видно.
 *
 * Копирайт переехал с `white/40` на `--muted`: прежняя пара давала 3.82:1 и была единственной
 * непройденной проверкой контраста во всей доступности (SC-002). Год считается на сборке —
 * страница статическая.
 */
import Icon, { type IconName } from './Icon.astro';
import Monogram from './Monogram.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();

/**
 * Подпись домена (FR-035) выводится из канонического адреса сборки. Вторая копия хоста —
 * в разметке или в словаре — разошлась бы с первой при смене хоста, и разошлась бы молча.
 * Без `site` неверны и канонические адреса, и карта сайта, поэтому сборка обязана упасть
 * здесь, а не отдать подвал с пустой подписью.
 */
if (!Astro.site) throw new Error('`site` не объявлен в astro.config.mjs: подпись домена не из чего вывести');
const domain = Astro.site.host.replace(/^www\./, '');
const map =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2540.5!2d30.5213!3d50.4501!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40d4ce50f8b6e3ed%3A0x5f1e4d5b5a5b5e5d!2z0YPQuy4g0JzQsNC70LDRjyDQltC40YLQvtC80LjRgNGB0LrQsNGPLCAxMCwg0JrQuNC10LI!5e0!3m2!1sru!2sua!4v1234567890';

interface Contact {
  readonly icon: IconName;
  readonly label: string;
}

const labels: Contact[] = [
  { icon: 'map-pin', label: t.footer.labels.address },
  { icon: 'phone', label: t.footer.labels.phone },
  { icon: 'clock', label: t.footer.labels.hours },
  { icon: 'instagram', label: t.footer.labels.instagram },
];
---

<footer id="contacts" class="foot">
  <div class="mx-auto max-w-6xl px-4">
    <div class="foot__grid">
      <div class="contacts">
        <!-- Уровень секции, а не подраздела: подвал — цель пункта меню и сам по себе раздел
             страницы, а `h3` объявлял его подчинённым той секции, что стоит выше по разметке.
             На странице ошибки, где секций с `h2` нет вовсе, он к тому же шёл сразу за `h1`.
             Оформление даёт класс `eyebrow`, поэтому уровень здесь ничего не задаёт на вид. -->
        <h2 class="eyebrow foot__title">{t.nav.contacts}</h2>

        <div class="contact">
          <span class="contact__label">
            <Icon name={labels[0].icon} size={14} class="text-brass" />
            <span class="eyebrow contact__name">{labels[0].label}</span>
          </span>
          <p class="contact__value">{t.footer.address}</p>
          <p class="contact__note">{t.footer.landmark}</p>
        </div>

        <div class="contact">
          <span class="contact__label">
            <Icon name={labels[1].icon} size={14} class="text-brass" />
            <span class="eyebrow contact__name">{labels[1].label}</span>
          </span>
          <p class="contact__value">
            <a href="tel:+380995570045" class="contact__link">(099) 557-00-45</a>
          </p>
        </div>

        <div class="contact">
          <span class="contact__label">
            <Icon name={labels[2].icon} size={14} class="text-brass" />
            <span class="eyebrow contact__name">{labels[2].label}</span>
          </span>
          <p class="contact__value">{t.footer.schedule}</p>
          <p class="contact__note">{t.footer.appointment}</p>
        </div>

        <div class="contact">
          <span class="contact__label">
            <Icon name={labels[3].icon} size={14} class="text-brass" />
            <span class="eyebrow contact__name">{labels[3].label}</span>
          </span>
          <p class="contact__value">
            <a
              href="https://www.instagram.com/massage.ln.kyiv/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact__link">@massage.ln.kyiv</a
            >
          </p>
        </div>
      </div>

      <!-- Кадр Google остаётся кадром Google: тёмный вид даёт фильтр поверх него, а не подмена
           карты (FR-024). Интерактив и атрибуция при инверсии сохраняются. -->
      <div class="map">
        <iframe
          src={map}
          width="100%"
          height="100%"
          style="border: 0; min-height: 250px"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lada N Location"></iframe>
      </div>
    </div>

    <div class="rule foot__rule"></div>

    <div class="foot__base">
      <span class="foot__mark">
        <Monogram mode="mark" />
        <span class="foot__sep">|</span>
        <span class="foot__name">Lada N</span>
        <!-- Не ссылка: посетитель уже здесь. Подпись возвращает адрес читателю снимка экрана,
             на котором адресной строки нет (FR-035). -->
        <span class="foot__sep">|</span>
        <span class="foot__domain">{domain}</span>
      </span>

      <p class="foot__rights">&copy; {year} Lada N. {t.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 1;
    padding-block: var(--rhythm-work) var(--rhythm-tight);
    border-top: 1px solid var(--hair-soft);
    background: rgb(var(--ink) / 0.78);
  }

  .foot__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  @media (min-width: 58rem) {
    .foot__grid {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
    }
  }

  .contacts {
    display: grid;
    align-content: start;
    gap: 1.75rem;
  }

  .foot__title {
    margin-bottom: 0.25rem;
  }

  .contact {
    display: grid;
    gap: 0.3rem;
  }

  .contact__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Подпись блока — служебный уровень: она называет назначение, а не несёт содержание. */
  .contact__name {
    @apply text-muted;
  }

  .contact__value {
    @apply text-silk;
    font-size: var(--step-body);
  }

  .contact__note {
    @apply text-muted;
    font-size: var(--step-caption);
  }

  .contact__link {
    text-decoration: none;
    border-bottom: 1px solid var(--hair);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s;
  }

  .contact__link:hover {
    @apply text-brass;
  }

  /**
   * Инверсия с поворотом тона и приглушением насыщенности (research.md §R10): тёмная карта
   * без ключа API, без новых запросов и без замены сервиса. Без поворота тона синяя вода
   * стала бы оранжевой.
   */
  .map {
    position: relative;
    min-height: 17rem;
    overflow: hidden;
    border: 1px solid var(--hair-soft);
    filter: invert(0.92) hue-rotate(180deg) saturate(0.6);
  }

  .map iframe {
    display: block;
    height: 100%;
  }

  .foot__rule {
    margin-top: var(--rhythm-tight);
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
  }

  .foot__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .foot__sep,
  .foot__rights {
    @apply text-muted;
    font-size: var(--step-caption);
  }

  .foot__name {
    @apply text-silk-dim;
    font-size: var(--step-caption);
    letter-spacing: 0.08em;
  }

  /* Разрядка надзаголовков при кегле соседей по полосе: подпись служебная, но набрана строчными —
     доменное имя набирают так, а не прописными. */
  .foot__domain {
    @apply text-muted;
    font-size: var(--step-caption);
    letter-spacing: 0.22em;
  }
</style>
