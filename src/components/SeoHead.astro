---
/**
 * Заголовочная часть страницы по docs/specs/page-head.md и машиночитаемое описание
 * по docs/specs/structured-data.md. Компонент принимает локаль и страницу услуги — всё остальное
 * вычисляется: метаданные страницы нигде не хранятся.
 */
import { getImage } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import logo from '../assets/logo.jpg';
import { aboutCopy } from '../data/about';
import { portrait } from '../data/gallery';
import { groupsOfCategory } from '../data/price-groups';
import { pricesOfGroups } from '../data/price-list';
import { serviceCopy } from '../data/services';
import { subpageCopy } from '../data/subpages';
import { formatDuration, formatSessions, ui, locales, type Locale } from '../i18n/ui';
import {
  absoluteUrl,
  canonicalUrl,
  languageAlternates,
  pageLocales,
  serviceSubpages,
  type ServicePageRef,
} from '../i18n/paths';

interface Props {
  locale: Locale;
  /** Нет у главной: её заголовок, описание и описание организации берутся из словаря. */
  page?: ServicePageRef;
}

/** Формат площадок предпросмотра — язык с территорией, в отличие от кода языка в разметке. */
const OG_LOCALE: Record<Locale, string> = { uk: 'uk_UA', ru: 'ru_RU', en: 'en_US' };

const PHONE = '+380995570045';
const INSTAGRAM = 'https://www.instagram.com/lada_n_kyiv/';

/** Вуз Лады — имя собственное, одно на все локали; источник адреса — docs/specs/structured-data.md. */
const ALMA_MATER = {
  '@type': 'CollegeOrUniversity',
  name: 'Національний університет фізичного виховання і спорту України',
  sameAs: 'https://uni-sport.edu.ua/',
};
const WEEK = [
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
  'Sunday',
];

const { locale, page } = Astro.props;

const t = ui[locale];
const canonical = canonicalUrl(locale, page);
const { alternates, xDefault } = languageAlternates(page);
const face = (await portrait()).data;

/**
 * Превью ссылок — кадр портрета Лады 1200×630 с центром на лице. Собирается
 * сборкой, а не лежит в статике: хэш в имени зависит от исходника и параметров кадра, поэтому
 * адрес меняется только вместе с картинкой — ровно тогда, когда соцсетям и нужно перечитать её
 * (docs/specs/home-hero.md §Превью ссылок и JSON-LD). Размеры для разметки берутся из результата.
 */
const preview = await getImage({
  src: face.photo,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: face.previewPosition,
  format: 'jpeg',
});
const ogImage = absoluteUrl(preview.src);

/**
 * Заголовок и описание страницы услуги — категории или подстраницы — берутся из frontmatter её
 * текста, а не собираются шаблоном с подставленным названием: одинаково устроенные заголовки на
 * шестнадцати страницах услуг — тот же дубль, только автоматический (docs/specs/page-head.md
 * §Заголовки и описания).
 */
const copy = !page
  ? null
  : page.subpage
    ? await subpageCopy(locale, page.subpage)
    : await serviceCopy(locale, page.category);

const title = copy ? copy.data.title : t.meta.title;
const description = copy ? copy.data.description : t.meta.description;

type PriceData = CollectionEntry<'prices'>['data'];

function amountsOf(price: PriceData['price'] | PriceData['sugar']): number[] {
  if (!price) return [];
  if (price.kind === 'fixed') return [price.amount];
  if (price.kind === 'variants') return price.variants.map((variant) => variant.amount);
  return [];
}

/**
 * Ценовой диапазон считается из прайса, а не вписывается строкой: вписанный вручную он
 * разойдётся с ценами при первой же правке. Цены пастой — тоже цены студии и участвуют;
 * долевые позиции не участвуют — доля не сумма.
 */
const amounts = (await getCollection('prices')).flatMap(({ data }) => [
  ...amountsOf(data.price),
  ...amountsOf(data.sugar),
]);

/** Разделитель населённого пункта и улицы в строке адреса; так устроены все три локали. */
const ADDRESS_SEPARATOR = ', ';

/**
 * Адрес в машиночитаемом виде выводится из той же строки словаря, которую видит посетитель:
 * второй записи адреса в проекте нет, поэтому разойтись им не с чем. До первого разделителя —
 * населённый пункт, после — улица.
 *
 * Строка, устроенная иначе, останавливает сборку, а не получает запасной вариант. Разбор без
 * проверки давал две правдоподобные строки — адрес без последнего символа и адрес без первого
 * (`indexOf` вернул -1), — и обе остаются частями исходной строки, поэтому проверка контракта
 * их пропускала. Адрес правится раз в несколько лет; поймать подмену на сборке дешевле, чем
 * обнаружить её в выдаче поисковика.
 */
function postalAddress(source: string) {
  const separator = source.indexOf(ADDRESS_SEPARATOR);
  if (separator > 0) {
    const addressLocality = source.slice(0, separator).trim();
    const streetAddress = source.slice(separator + ADDRESS_SEPARATOR.length).trim();
    if (addressLocality.length > 0 && streetAddress.length > 0) {
      return { addressLocality, streetAddress };
    }
  }

  throw new Error(
    `SeoHead: адрес локали «${locale}» не разбирается на населённый пункт и улицу. ` +
      `Строка словаря: «${source}». Ожидается «населённый пункт${ADDRESS_SEPARATOR}улица» — ` +
      'поле «address» описания организации (docs/specs/structured-data.md §Главная, три локали).',
  );
}

const { addressLocality, streetAddress } = postalAddress(t.footer.address);

/** Имя основательницы — из подписи её обращения: подпись и разметка не могут разойтись. */
const founder = page
  ? null
  : {
      '@type': 'Person',
      '@id': `${canonical}#founder`,
      name: (await aboutCopy(locale)).data.signatureName,
      jobTitle: t.meta.founderRole,
      image: absoluteUrl(face.photo.src),
      alumniOf: ALMA_MATER,
    };

const business = page
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'HealthAndBeautyBusiness',
      '@id': `${canonical}#business`,
      name: t.meta.siteName,
      url: canonical,
      image: [absoluteUrl(logo.src), absoluteUrl(face.photo.src)],
      telephone: PHONE,
      address: {
        '@type': 'PostalAddress',
        streetAddress,
        addressLocality,
        addressCountry: 'UA',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: WEEK,
          opens: '10:00',
          closes: '21:00',
        },
      ],
      priceRange: `${Math.min(...amounts)}–${Math.max(...amounts)} UAH`,
      sameAs: [INSTAGRAM],
      knowsLanguage: [...locales],
      founder,
    };

/**
 * Перечень предложений страницы услуги — по тем же группам и тем же ценам способа, что видит
 * посетитель в её прайсе. Позиция с фиксированной ценой даёт одно предложение, позиция
 * с вариантами — по одному на вариант, долевая не даёт ни одного: предложение без суммы или
 * с нулевой суммой описывает бесплатную услугу (ADR-013).
 */
const subpage = page?.subpage ? serviceSubpages[page.subpage] : null;
const priced = !page
  ? []
  : subpage
    ? await pricesOfGroups(subpage.groups, subpage.method)
    : await pricesOfGroups(groupsOfCategory(page.category));

/** Длительность или число сеансов — свойство самого предложения, а не часть его названия. */
function quantityOf(unit: 'minutes' | 'sessions', count: number) {
  return unit === 'minutes'
    ? { '@type': 'QuantitativeValue', value: count, unitCode: 'MIN' }
    : { '@type': 'QuantitativeValue', value: count, unitText: t.priceList.sessionOne };
}

const offers = priced.flatMap(({ data }) => {
  const price = data.price;
  const name = data.name[locale];
  const offer = { '@type': 'Offer', priceCurrency: 'UAH', availability: 'https://schema.org/InStock' };

  if (price.kind === 'fixed') return [{ ...offer, name, price: price.amount }];
  if (price.kind === 'variants') {
    return price.variants.map((variant) => ({
      ...offer,
      name: `${name} — ${
        price.unit === 'minutes'
          ? formatDuration(locale, variant.count)
          : formatSessions(locale, variant.count)
      }`,
      price: variant.amount,
      eligibleQuantity: quantityOf(price.unit, variant.count),
    }));
  }
  return [];
});

const home = canonicalUrl(locale);

/** Исполнитель — ссылка на организацию главной страницы своей локали, а не второе её описание. */
const service = copy
  ? {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: copy.data.heading,
      description,
      url: canonical,
      provider: { '@id': `${home}#business` },
      areaServed: { '@type': 'City', name: addressLocality },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: copy.data.heading,
        itemListElement: offers,
      },
    }
  : null;

/** Подстраница стоит под своей категорией: путь главная → категория → подстраница. */
const parentStep = page?.subpage
  ? [
      {
        name: (await serviceCopy(locale, page.category)).data.heading,
        item: canonicalUrl(locale, { category: page.category }),
      },
    ]
  : [];

const breadcrumb = copy
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: t.nav.home, item: home },
        ...parentStep,
        { name: copy.data.heading, item: canonical },
      ].map((step, index) => ({ '@type': 'ListItem', position: index + 1, ...step })),
    }
  : null;

const serviceGraph =
  service && breadcrumb ? { '@context': 'https://schema.org', '@graph': [service, breadcrumb] } : null;
---

<title>{title}</title>
<meta name="description" content={description} />

<link rel="canonical" href={canonical} />
{
  alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(preview.attributes.width)} />
<meta property="og:image:height" content={String(preview.attributes.height)} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{
  pageLocales(page)
    .filter((code) => code !== locale)
    .map((code) => <meta property="og:locale:alternate" content={OG_LOCALE[code]} />)
}
<meta property="og:site_name" content={t.meta.siteName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{business && <script type="application/ld+json" is:inline set:html={JSON.stringify(business)} />}
{
  serviceGraph && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceGraph)} />
  )
}
