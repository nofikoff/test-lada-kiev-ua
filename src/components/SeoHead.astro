---
/**
 * Заголовочная часть страницы по [contracts/page-head.md] и машиночитаемое описание
 * по [contracts/structured-data.md]. Компонент принимает локаль и категорию — всё остальное
 * вычисляется: метаданные страницы нигде не хранятся (data-model.md §Метаданные страницы).
 */
import { getCollection } from 'astro:content';
import logo from '../assets/logo.jpg';
import hero from '../assets/massage-kiev-lada-novikova.jpg';
import { ui, locales, type Locale } from '../i18n/ui';
import {
  absoluteUrl,
  canonicalUrl,
  languageAlternates,
  type ServiceCategory,
} from '../i18n/paths';

interface Props {
  locale: Locale;
  category?: ServiceCategory;
}

/** Формат площадок предпросмотра — язык с территорией, в отличие от кода языка в разметке. */
const OG_LOCALE: Record<Locale, string> = { uk: 'uk_UA', ru: 'ru_RU', en: 'en_US' };

/**
 * Изображение предпросмотра лежит в статических файлах и оптимизации сборки не подвергается:
 * имена оптимизированных файлов содержат хэш и меняются при пересборке, а соцсети кэшируют адрес.
 * Поэтому же оно пережато один раз вручную (Step 4.1) с сохранением имени и типа файла:
 * 2970×1756 и 3.3 МБ против объявленных здесь размеров и лимита в 300 КБ — до пережатия
 * объявление было ложным. Размеры ниже соответствуют файлу и проверяются тестом контракта.
 */
const OG_IMAGE = { path: '/assets/lada.kiev.ua-website.png', width: '1416', height: '840' };

const PHONE = '+380995570045';
const INSTAGRAM = 'https://www.instagram.com/massage.ln.kyiv/';
const WEEK = [
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
  'Sunday',
];

const { locale, category } = Astro.props;

const t = ui[locale];
const canonical = canonicalUrl(locale, category);
const { alternates, xDefault } = languageAlternates(category);
const ogImage = absoluteUrl(OG_IMAGE.path);

const title = t.meta.title;
const description = t.meta.description;

/**
 * Ценовой диапазон считается из прайса, а не вписывается строкой: вписанный вручную он
 * разойдётся с ценами при первой же правке. Долевые позиции не участвуют — доля не сумма.
 */
const amounts = (await getCollection('prices')).flatMap(({ data }) =>
  data.price.kind === 'fixed'
    ? [data.price.amount]
    : data.price.kind === 'variants'
      ? data.price.variants.map((variant) => variant.amount)
      : [],
);

/**
 * Адрес в машиночитаемом виде выводится из той же строки словаря, которую видит посетитель:
 * второй записи адреса в проекте нет, поэтому разойтись им не с чем. До первой запятой —
 * населённый пункт, после — улица; так устроены все три локали.
 */
const [addressLocality, streetAddress] = (() => {
  const separator = t.footer.address.indexOf(', ');
  return [t.footer.address.slice(0, separator), t.footer.address.slice(separator + 2)];
})();

const business = category
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'HealthAndBeautyBusiness',
      '@id': `${canonical}#business`,
      name: t.meta.siteName,
      url: canonical,
      image: [absoluteUrl(logo.src), absoluteUrl(hero.src)],
      telephone: PHONE,
      address: {
        '@type': 'PostalAddress',
        streetAddress,
        addressLocality,
        addressCountry: 'UA',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: WEEK,
          opens: '10:00',
          closes: '21:00',
        },
      ],
      priceRange: `${Math.min(...amounts)}–${Math.max(...amounts)} UAH`,
      sameAs: [INSTAGRAM],
      availableLanguage: [...locales],
    };
---

<title>{title}</title>
<meta name="description" content={description} />

<link rel="canonical" href={canonical} />
{
  alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={OG_IMAGE.width} />
<meta property="og:image:height" content={OG_IMAGE.height} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{
  locales
    .filter((code) => code !== locale)
    .map((code) => <meta property="og:locale:alternate" content={OG_LOCALE[code]} />)
}
<meta property="og:site_name" content={t.meta.siteName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{business && <script type="application/ld+json" is:inline set:html={JSON.stringify(business)} />}
