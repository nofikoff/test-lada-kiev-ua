---
/**
 * Пара «надзаголовок + заголовок». Обе строки обязательны, и это не придирка к типам:
 * надзаголовок в одиночку — латунная строка капителью, которую читатель принимает за заголовок
 * секции, а экранный диктор не объявляет вовсе (docs/specs/design-tokens.md, правило 7).
 * Пропуск любой из строк роняет `astro check`, а не отображение.
 */
interface Props {
  eyebrow: string;
  title: string;
  /**
   * Уровень заголовка. Умолчание `h2` — уровень секции первой вложенности, и другого у секций
   * этого сайта нет: надзаголовок заголовком не является, поэтому понижение уровня «потому что
   * над ним стоит строка» даёт разрыв ступени, а не вложенность (`tests/headings.spec.ts`).
   */
  level?: 'h1' | 'h2' | 'h3';
  /** Выравнивание пары по левому краю — умолчание; по центру нужно карточке сертификатов. */
  align?: 'start' | 'center';
  class?: string;
}

const { eyebrow, title, level = 'h2', align = 'start', class: className } = Astro.props;

const Heading = level;
---

<div class:list={['heading', `heading--${align}`, className]}>
  <span class="eyebrow">{eyebrow}</span>
  <Heading class="section-title">{title}</Heading>
</div>

<style>
  .heading {
    display: grid;
    gap: 0.9rem;
  }

  .heading--center {
    justify-items: center;
    text-align: center;
  }
</style>
